import Mathlib.Tactic
import PhiGenesis.H10.GasketCoordinates

/-!
# Recursive first-occurrence vertex order

The Python graph constructor visits the three child copies in order 0, 1, 2.
Its coordinate dictionary assigns a vertex ID on the first occurrence of
each coordinate.  The list below is the exact integer-coordinate version
of that procedure: concatenate the three mapped child lists, retaining
each point at its first occurrence.

This separates vertex discovery order from the later lexicographic sorting
of undirected primal edges.
-/

namespace PhiGenesis.H10

/-- A fuel-bounded left-to-right scan that keeps the first occurrence of
each element and removes all later copies from the unprocessed suffix. -/
def gasketFirstOccurrencesAux [DecidableEq α] :
    Nat → List α → List α
  | 0, _ => []
  | Nat.succ fuel, [] => []
  | Nat.succ fuel, a :: xs =>
      a :: gasketFirstOccurrencesAux fuel (xs.filter (fun x => x ≠ a))

/-- Every element output by the scan was present in the input list. -/
theorem gasketFirstOccurrencesAux_mem [DecidableEq α] :
    ∀ (fuel : Nat) (xs : List α) {a : α},
      a ∈ gasketFirstOccurrencesAux fuel xs → a ∈ xs := by
  intro fuel
  induction fuel with
  | zero =>
      intro xs a h
      simp [gasketFirstOccurrencesAux] at h
  | succ fuel ih =>
      intro xs
      cases xs with
      | nil =>
          intro a h
          simp [gasketFirstOccurrencesAux] at h
      | cons b bs =>
          intro a h
          simp only [gasketFirstOccurrencesAux, List.mem_cons] at h
          rcases h with h | h
          · subst a
            simp
          · have hfiltered : a ∈ bs.filter (fun x => x ≠ b) := ih _ h
            simp only [List.mem_cons]
            exact Or.inr (List.mem_filter.mp hfiltered).1

/-- If fuel is at least the input length, the scan retains every
distinct input value. -/
theorem gasketFirstOccurrencesAux_complete [DecidableEq α] :
    ∀ (fuel : Nat) (xs : List α),
      xs.length ≤ fuel →
      ∀ {a : α}, a ∈ xs → a ∈ gasketFirstOccurrencesAux fuel xs := by
  intro fuel
  induction fuel with
  | zero =>
      intro xs hlen a ha
      cases xs with
      | nil =>
          simp at ha
      | cons b bs =>
          simp at hlen
  | succ fuel ih =>
      intro xs hlen a ha
      cases xs with
      | nil =>
          simp at ha
      | cons b bs =>
          simp only [List.length_cons] at hlen
          rcases List.mem_cons.mp ha with hhead | htail
          · subst a
            simp [gasketFirstOccurrencesAux]
          · by_cases hab : a = b
            · subst a
              simp [gasketFirstOccurrencesAux]
            · have hneq : decide (a ≠ b) = true := by
                simp [hab]
              have hfiltered :
                  a ∈ bs.filter (fun x => x ≠ b) :=
                List.mem_filter.mpr ⟨htail, hneq⟩
              have hfilterLength :
                  (bs.filter (fun x => x ≠ b)).length ≤ bs.length := by
                exact List.length_filter_le (fun x => decide (x ≠ b)) bs
              have hlength' :
                  (bs.filter (fun x => x ≠ b)).length ≤ fuel := by
                omega
              have hrec := ih _ hlength' hfiltered
              simp [gasketFirstOccurrencesAux, hrec]

/-- Keep the first occurrence of every point in a finite list. -/
def gasketFirstOccurrences [DecidableEq α] (xs : List α) : List α :=
  gasketFirstOccurrencesAux xs.length xs

/-- The first-occurrence scan does not change the underlying membership set. -/
theorem gasketFirstOccurrences_mem_iff [DecidableEq α]
    (xs : List α) (a : α) :
    a ∈ gasketFirstOccurrences xs ↔ a ∈ xs := by
  unfold gasketFirstOccurrences
  constructor
  · exact gasketFirstOccurrencesAux_mem xs.length xs
  · intro h
    exact gasketFirstOccurrencesAux_complete xs.length xs
      (Nat.le_refl _) h

/-- The first-occurrence scan produces a list with no duplicate entries. -/
theorem gasketFirstOccurrences_nodup [DecidableEq α]
    (xs : List α) : (gasketFirstOccurrences xs).Nodup := by
  unfold gasketFirstOccurrences
  have hnodup :
      ∀ (fuel : Nat) (ys : List α),
        (gasketFirstOccurrencesAux fuel ys).Nodup := by
    intro fuel
    induction fuel with
    | zero =>
        intro ys
        simp [gasketFirstOccurrencesAux]
    | succ fuel ih =>
        intro ys
        cases ys with
        | nil =>
            simp [gasketFirstOccurrencesAux]
        | cons b bs =>
            simp only [gasketFirstOccurrencesAux, List.nodup_cons]
            constructor
            · intro hmem
              have hfiltered :
                  b ∈ bs.filter (fun x => x ≠ b) :=
                gasketFirstOccurrencesAux_mem fuel _ hmem
              have hfalse : decide (b ≠ b) = true :=
                (List.mem_filter.mp hfiltered).2
              simp at hfalse
            · exact ih _
  exact hnodup xs.length xs

/-- The ordered vertex list generated by the Python recursion, now using
exact integer lattice coordinates.  Child blocks are visited 0, then 1,
then 2; repeated shared vertices keep their earliest occurrence. -/
def gasketVertexOrder : Nat → List GasketLatticePoint
  | 0 => [(0, 0), (1, 0), (0, 1)]
  | n + 1 =>
      let previous := gasketVertexOrder n
      gasketFirstOccurrences
        ((previous.map (gasketChildPoint n .corner0)) ++
          ((previous.map (gasketChildPoint n .corner1)) ++
            (previous.map (gasketChildPoint n .corner2))))

@[simp] theorem gasketVertexOrder_zero :
    gasketVertexOrder 0 = [(0, 0), (1, 0), (0, 1)] := rfl

/-- The recursive first-occurrence vertex list is duplicate-free at every level. -/
theorem gasketVertexOrder_nodup (n : Nat) :
    (gasketVertexOrder n).Nodup := by
  cases n with
  | zero =>
      decide
  | succ n =>
      change
        (gasketFirstOccurrences
          ((gasketVertexOrder n).map (gasketChildPoint n .corner0) ++
            ((gasketVertexOrder n).map (gasketChildPoint n .corner1) ++
              (gasketVertexOrder n).map (gasketChildPoint n .corner2)))).Nodup
      exact gasketFirstOccurrences_nodup _

/-- Every vertex of a child copy occurs in the parent's first-occurrence list. -/
theorem gasketVertexOrder_succ_mem_of_child
    (n : Nat) (c : GasketChild) (p : GasketLatticePoint)
    (hp : p ∈ gasketVertexOrder n) :
    gasketChildPoint n c p ∈ gasketVertexOrder (n + 1) := by
  change
    gasketChildPoint n c p ∈
      gasketFirstOccurrences
        ((gasketVertexOrder n).map (gasketChildPoint n .corner0) ++
          ((gasketVertexOrder n).map (gasketChildPoint n .corner1) ++
            (gasketVertexOrder n).map (gasketChildPoint n .corner2)))
  apply (gasketFirstOccurrences_mem_iff _ _).2
  cases c with
  | corner0 =>
      exact List.mem_append_left _
        (List.mem_map.mpr ⟨p, hp, rfl⟩)
  | corner1 =>
      exact List.mem_append_right _
        (List.mem_append_left _ (List.mem_map.mpr ⟨p, hp, rfl⟩))
  | corner2 =>
      exact List.mem_append_right _
        (List.mem_append_right _ (List.mem_map.mpr ⟨p, hp, rfl⟩))

/-- The three outer corners remain vertices in the recursively generated list. -/
theorem gasketVertexOrder_outerCorners_mem (n : Nat) :
    gasketOuterCorner n .corner0 ∈ gasketVertexOrder n ∧
    gasketOuterCorner n .corner1 ∈ gasketVertexOrder n ∧
    gasketOuterCorner n .corner2 ∈ gasketVertexOrder n := by
  induction n with
  | zero =>
      decide
  | succ n ih =>
      rcases ih with ⟨h0, h1, h2⟩
      refine ⟨?_, ?_, ?_⟩
      · have h := gasketVertexOrder_succ_mem_of_child
          n .corner0 (gasketOuterCorner n .corner0) h0
        simpa [gasketOuterCorner, gasketChildPoint] using h
      · have h := gasketVertexOrder_succ_mem_of_child
          n .corner1 (gasketOuterCorner n .corner1) h1
        simpa [gasketOuterCorner, gasketChildPoint, gasketScale_succ] using h
      · have h := gasketVertexOrder_succ_mem_of_child
          n .corner2 (gasketOuterCorner n .corner2) h2
        simpa [gasketOuterCorner, gasketChildPoint, gasketScale_succ] using h

end PhiGenesis.H10
